SUPABASE_URL=http://127.0.0.1:54321 # Supabase uses this URL for local dev
SUPABASE_SECRET_KEY = sbservice... #For bypassing row level security
SUPABASE_PUBLISHABLE_KEY=sb_publishable...
OPENAI_API_KEY=# Get key from 1Password
FRONTEND_URL=https://your-frontend.vercel.app # Optional; enables CORS for production frontend

# OpenAI client (embeddings and general API calls)
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1

# Scoring configuration (LLM job-match scoring)
OPENAI_SCORING_MODEL=gpt-5.4-nano
OPENAI_SCORING_TIMEOUT_SECONDS=75
OPENAI_SCORING_MAX_RETRIES=0
SCORING_REASONING_EFFORT=none
SCORING_BATCH_SIZE=5
SCORING_PARALLELISM=2
SCORING_RESUME_CHAR_LIMIT=6000
SCORING_JOB_DESCRIPTION_CHAR_LIMIT=1000

# Turso (libSQL) — the `jobs` table now lives here.
# Get these from https://app.turso.tech after creating a database called
# `matchpoint-jobs` (or whatever name you prefer).
TURSO_AUTH_TOKEN=
TURS...io

# Embedding matrix cache — read path for vector_search.
# Set EMBEDDINGS_SOURCE to one of: github, local, turso.
#   github (default in prod): fetch matrix.npy + matrix_ids.json from the
#     `data-cache` branch in this repo. Repo must be public.
#   local: read from EMBEDDINGS_LOCAL_PATH. Used for testing.
#   turso: disable the cache; fall back to the slow SELECT path.
EMBEDDINGS_SOURCE=github
GITHUB_REPO_OWNER=dmboynton56
GITHUB_REPO_NAME=matchpoint
EMBEDDINGS_BRANCH_REF=data-cache
EMBEDDINGS_LOCAL_PATH=   # only used when EMBEDDINGS_SOURCE=local
EMBEDDINGS_FETCH_TIMEOUT_SECONDS=10
